<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp">

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Your Combo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

    <TextView
            android:id="@+id/comboDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

    <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Side:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        <ImageView
                android:id="@+id/chipsImageView"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="20dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/chips"
                android:contentDescription="Chips"/>

        <!-- Apple Image -->
        <ImageView
                android:id="@+id/appleImageView"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/apple_slices"
                android:contentDescription="Apple Slices"/>
    </LinearLayout>

    <RadioGroup
            android:id="@+id/sideRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        <RadioButton
                android:id="@+id/chipsRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="60dp"
                android:text="Chips"/>

        <RadioButton
                android:id="@+id/appleRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apple Slices"/>
    </RadioGroup>

    <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="16dp"/>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Drink:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        <ImageView
                android:id="@+id/colaImageView"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/cola"
                android:contentDescription="Cola"/>

        <ImageView
                android:id="@+id/teaImageView"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/tea"
                android:contentDescription="Tea"/>

        <!-- Juice Image -->
        <ImageView
                android:id="@+id/juiceImageView"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/juice"
                android:contentDescription="Juice"/>
    </LinearLayout>

    <RadioGroup
            android:id="@+id/drinkRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        <RadioButton
                android:id="@+id/colaRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="40dp"
                android:text="Cola"/>

        <RadioButton
                android:id="@+id/teaRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="40dp"
                android:text="Tea"/>

        <RadioButton
                android:id="@+id/juiceRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Juice"/>
    </RadioGroup>

    <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="16dp"/>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Combo includes discounted pricing!"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        <Button
                android:id="@+id/addComboButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Combo"
                android:layout_marginEnd="16dp"/>

        <Button
                android:id="@+id/cancelComboButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"/>
    </LinearLayout>
</LinearLayout>