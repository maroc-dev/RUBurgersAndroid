<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a Side"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

        <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="16dp">

            <!-- Chips -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:orientation="vertical"
                    android:gravity="center">

                <ImageButton
                        android:id="@+id/chipsButton"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/chips"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/chips" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chips"
                        android:textSize="16sp"
                        android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Fries -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:orientation="vertical"
                    android:gravity="center">

                <ImageButton
                        android:id="@+id/friesButton"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/fries"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/fries" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fries"
                        android:textSize="16sp"
                        android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Onion Rings -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:orientation="vertical"
                    android:gravity="center">

                <ImageButton
                        android:id="@+id/onionRingsButton"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/onion_rings"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/onion_rings" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onion_rings"
                        android:textSize="16sp"
                        android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Apple Slices -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:orientation="vertical"
                    android:gravity="center">

                <ImageButton
                        android:id="@+id/appleSlicesButton"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/apple_slices"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/apple_slices" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apple_slices"
                        android:textSize="16sp"
                        android:layout_marginTop="8dp" />
            </LinearLayout>
        </GridLayout>

        <Button
                android:id="@+id/viewOrderButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_order"
                android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>